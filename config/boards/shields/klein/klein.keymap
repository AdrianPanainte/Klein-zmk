#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/input_transform.h>

#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>

#define BASE 0
#define NAV  1
#define NUM  2
#define FUN  3
#define SYM  4
#define MEDIA  5
#define BLU 6
#define APPSW 7  // auto-enabled while the knob drives the Cmd+Tab switcher

// Knob bindings: first binding = counter-clockwise, second = clockwise
// (same order as the volume bindings below). Swap pairs if a direction feels backwards.

// Wheel speed per detent. &msc emits speed * 16ms / 1000 per 16ms tick and the
// knob holds it for one tick (tap-ms below), so 150 => 2 wheel notches per detent.
#define ENC_SCROLL_SPEED 150

&mt {
  quick-tap-ms = <100>;
  global-quick-tap;
  flavor = "tap-preferred";
  tapping-term-ms = <180>;
};

/ {
    behaviors {
        // Base layer: knob = mouse wheel
        scrl_enc: scrl_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(ENC_SCROLL_SPEED)>, <&msc MOVE_Y(-ENC_SCROLL_SPEED)>;
            tap-ms = <24>;
        };

        // NUM layer (hold BKSP): knob = Cmd+Tab app switcher.
        // First detent turns on APPSW and presses Right Cmd, held until BKSP is released.
        // Right Cmd is used so it never clashes with the home-row Cmd (LGUI on A and ').
        appsw_enc: appsw_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&appsw_p>, <&appsw_n>;
        };

        appsw_n: appsw_n {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_tap &tog_on APPSW>
                , <&macro_press &kp RGUI>
                , <&macro_tap &kp TAB>
                ;
        };

        appsw_p: appsw_p {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_tap &tog_on APPSW>
                , <&macro_press &kp RGUI>
                , <&macro_tap &kp LS(TAB)>
                ;
        };

        // Momentary layer that, on release, also lets go of the switcher's Cmd and APPSW.
        // RGUI is released twice in case a very fast flick pressed it twice; extra releases are no-ops.
        mo_appsw: mo_appsw {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_release &kp RGUI &kp RGUI>
                , <&macro_tap &tog_off APPSW>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };

        // Same as &lt, but the hold side is &mo_appsw
        lt_appsw: lt_appsw {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo_appsw>, <&kp>;
        };

        tog_on: tog_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
//          ------------------------------------------------------------------------------------------------------------
//          |  Q  |  W  |  E   |  R   |  T   |                                           |  Y   |  U    |  I    |  O   |   P   |
//          |  A  |  S  |  D   |  F   |  G   |                                           |  H   |  J    |  K    |  L   |   '   |
//          |  Z  |  X  |  C   |  V   |  B   |                                           |  N   |  M    |  ,    |  .   |   /   |
//                      | ESC  | SPC |  TAB | BOOTLOADER |                          | RET | BKSP | DEL |

            bindings = <
&kp Q          &kp W          &kp E          &kp R          &kp T               &kp Y          &kp U          &kp I          &kp O          &kp P
&mt LGUI A     &mt LALT S     &mt LCTRL D    &mt LSHFT F    &kp G               &kp H          &mt RSHFT J    &mt RCTRL K    &mt RALT L     &mt LGUI SQT
&kp Z          &kp X          &kp C          &kp V          &kp B               &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH
&lt MEDIA ESC  &lt NAV SPACE  &lt BLU TAB    &kp K_MUTE                                                       &lt SYM RET    &lt_appsw NUM BKSP &lt FUN DEL
            >;
            sensor-bindings = <&scrl_enc>;
        };

        nav_layer {

            bindings = <
&trans         &trans         &trans         &trans         &trans              &kp CAPSLOCK   &bt BT_CLR     &kp K_CUT      &kp K_COPY     &kp K_PASTE
&kp LGUI       &kp LALT       &kp LCTRL      &kp LSHFT      &trans              &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &trans
&trans         &trans         &trans         &trans         &trans              &kp INSERT     &kp HOME       &kp PG_UP      &kp PG_DN      &kp END
&trans         &trans         &trans         &bootloader                                                      &kp RET        &kp BKSP       &kp DEL
            >;
        sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        num_layer {
            
            bindings = <
&kp LBKT       &kp N7         &kp N8         &kp N9         &kp RBKT            &trans         &trans         &trans         &trans         &trans
&kp SEMI       &kp N4         &kp N5         &kp N6         &kp EQUAL           &trans         &kp LSHFT      &kp LCTRL      &kp LALT       &kp LGUI
&kp GRAVE      &kp N1         &kp N2         &kp N3         &kp BSLH            &trans         &trans         &trans         &trans         &trans
&kp PERIOD     &kp N0         &kp MINUS      &bootloader                                                      &trans         &trans         &trans
            >;
            sensor-bindings = <&appsw_enc>;  // hold BKSP + knob: switch apps (Cmd+Tab)
        };

        fun_layer {
            
            bindings = <
&kp F12        &kp F7         &kp F8         &kp F9         &kp PSCRN           &trans         &trans         &trans         &trans         &trans
&kp F11        &kp F4         &kp F5         &kp F6         &kp SYSREQ          &trans         &kp LSHFT      &kp LCTRL      &kp LALT       &kp LGUI
&kp F10        &kp F1         &kp F2         &kp F3         &kp PAUSE_BREAK     &trans         &trans         &trans         &trans         &trans
&kp ESC        &kp SPACE      &kp TAB        &bootloader                                                      &trans         &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp LG(LS(GRAVE)) LG(GRAVE)>;  // hold DEL + knob: windows of the same app (Cmd+`)
        };

        sym_layer {
            
            bindings = <
&kp LS(LBKT)   &kp LS(N7)     &kp LS(N8)     &kp LS(N9)     &kp LS(RBKT)        &trans         &trans         &trans         &trans         &trans
&kp LS(SEMI)   &kp LS(N4)     &kp LS(N5)     &kp LS(N6)     &kp LS(EQUAL)       &trans         &kp LSHFT      &kp LCTRL      &kp LALT       &kp LGUI
&kp LS(GRAVE)  &kp LS(N1)     &kp LS(N2)     &kp LS(N3)     &kp LS(BSLH)        &trans         &trans         &trans         &trans         &trans
&kp LS(PERIOD) &kp LS(N0)     &kp LS(MINUS)  &bootloader                                                      &trans         &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(LS(TAB)) LC(TAB)>;  // hold RET + knob: browser/editor tabs (Ctrl+Tab)
        };

        media_layer {
            
            bindings = <
&trans         &trans         &trans         &trans         &trans              &trans         &trans         &trans         &trans         &trans
&kp LGUI       &kp LALT       &kp LCTRL      &kp LSHFT      &trans              &kp K_PREV     &kp K_VOL_DN   &kp K_VOL_UP   &kp K_NEXT     &trans
&trans         &trans         &trans         &trans         &trans              &trans         &trans         &trans         &trans         &trans
&trans         &trans         &trans         &bootloader                                                      &kp K_STOP2    &kp K_PP       &kp K_MUTE
            >;
        sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        blu_layer {
            bindings = <
&trans         &trans         &trans         &trans         &trans              &bt BT_CLR     &trans         &trans         &trans         &trans
&trans         &trans         &trans         &trans         &trans              &trans         &bt BT_PRV     &bt BT_NXT     &trans         &trans
&bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4        &trans         &trans         &trans         &trans         &trans
&trans         &trans         &trans         &trans                                                           &trans         &trans         &trans
            >;
        sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        // Turned on by the first knob detent on NUM; Right Cmd is already held, so just Tab
        appsw_layer {
            bindings = <
&trans         &trans         &trans         &trans         &trans              &trans         &trans         &trans         &trans         &trans
&trans         &trans         &trans         &trans         &trans              &trans         &trans         &trans         &trans         &trans
&trans         &trans         &trans         &trans         &trans              &trans         &trans         &trans         &trans         &trans
&trans         &trans         &trans         &trans                                                           &trans         &trans         &trans
            >;
        sensor-bindings = <&inc_dec_kp LS(TAB) TAB>;
        };
    };
};
 
